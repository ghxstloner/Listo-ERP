// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id               Int       @id @default(autoincrement())
  code             String    @unique // ISO 3166-1 alpha-2 (PA, VE, CO, etc.)
  name             String
  taxDocumentTypes Json // [{"code": "RUC", "name": "RUC", "hasCheckDigit": true}, ...]
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  companies        Company[]
}

model Company {
  id             Int     @id @default(autoincrement())
  name           String
  primaryColor   String  @default("#ff6600")
  secondaryColor String  @default("#180900")
  isActive       Boolean @default(true)

  // Contact information
  address String?
  city    String?
  phone1  String?
  phone2  String?
  email1  String?
  email2  String?

  // Tax information
  countryId         Int?
  defaultCustomerId Int?
  defaultSellerId   Int?
  taxDocumentType   String? // RUC, RIF, NIT, etc.
  taxDocumentNumber String?
  taxCheckDigit     String? // Dígito verificador (Panamá)
  fiscalName        String? // Razón social

  createdAt                             DateTime                               @default(now())
  updatedAt                             DateTime                               @updatedAt
  companyLogo                           String?                                @default("")
  defaultCurrencyId                     Int?
  companyUsers                          CompanyUser[]
  roles                                 CompanyRole[]
  branches                              branch[]
  tills                                 till[]
  departments                           Department[]
  subdepartments                        Subdepartment[]
  categories                            Category[]
  subcategories                         Subcategory[]
  suppliers                             Supplier[]
  purchaseOrders                        PurchaseOrder[]
  purchaseInvoices                      PurchaseInvoice[]
  inventoryTransfers                    InventoryTransfer[]
  customers                             Customer[]
  sellers                               Seller[]
  sellerUsers                           SellerUser[]
  products                              Product[]
  defaultCustomer                       Customer?                              @relation("CompanyDefaultCustomer", fields: [defaultCustomerId], references: [id], onDelete: SetNull)
  defaultSeller                         Seller?                                @relation("CompanyDefaultSeller", fields: [defaultSellerId], references: [id], onDelete: SetNull)
  defaultCurrency                       Currency?                              @relation("CompanyDefaultCurrency", fields: [defaultCurrencyId], references: [id])
  currencySettings                      CompanyCurrency[]
  exchangeRates                         ExchangeRate[]
  paymentMethods                        PaymentMethod[]
  country                               Country?                               @relation(fields: [countryId], references: [id])
  auditLogs                             AuditLog[]
  warehouses                            Warehouse[]
  inventoryBalances                     InventoryBalance[]
  inventoryMovements                    InventoryMovement[]
  hierarchyConfig                       CompanyHierarchyConfig?
  cashSessions                          CashSession[]
  sales                                 Sale[]
  orders                                Order[]
  electronicInvoicingConfigurations     ElectronicInvoicingConfiguration[]
  tillElectronicInvoicingConfigurations TillElectronicInvoicingConfiguration[]
  series                                Series[]
  taxes                                 Tax[]
}

model Tax {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  rate      Decimal  @db.Decimal(5, 4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
}

model CompanyUser {
  id        Int      @id @default(autoincrement())
  companyId Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id])
  user    User              @relation(fields: [userId], references: [id])
  roles   CompanyUserRole[]

  @@unique([companyId, userId])
}

// Kept only for compatibility with historical migrations. Authorization uses CompanyRole.
enum Role {
  ADMIN
  USER
}

model CompanyRole {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions CompanyRolePermission[]
  users       CompanyUserRole[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles CompanyRolePermission[]
}

model CompanyRolePermission {
  roleId       Int
  permissionId Int

  role       CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model CompanyUserRole {
  companyUserId Int
  roleId        Int

  companyUser CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  role        CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([companyUserId, roleId])
  @@index([roleId])
}

model User {
  id                      Int               @id @default(autoincrement())
  email                   String            @unique
  password                String
  name                    String            @unique
  userCode                String?           @unique
  isActive                Boolean           @default(true)
  resetPasswordCode       String?
  resetPasswordExpires    DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  companyUsers            CompanyUser[]
  sellerUsers             SellerUser[]
  auditLogs               AuditLog[]
  openedCashSessions      CashSession[]     @relation("CashSessionOpenedBy")
  closedCashSessions      CashSession[]     @relation("CashSessionClosedBy")
  sales                   Sale[]
  createdOrders           Order[]           @relation("OrderCreatedBy")
  createdPurchaseInvoices PurchaseInvoice[]
  createdTransfers        InventoryTransfer[] @relation("TransferCreatedBy")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  PASSWORD_CHANGE
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  userId      Int?
  companyId   Int?
  action      AuditAction
  description String
  section     String
  createdAt   DateTime    @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
}

model branch {
  id           Int               @id @default(autoincrement())
  name         String
  address      String?
  phone        String?
  branchCode   String?           @unique
  isActive     Boolean           @default(true)
  companyId    Int
  currencyId   Int?
  company      Company           @relation(fields: [companyId], references: [id])
  currency     Currency?         @relation(fields: [currencyId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tills        till[]
  warehouses   WarehouseBranch[]
  cashSessions CashSession[]
  sales        Sale[]
  orders       Order[]

  @@unique([companyId, branchCode])
}

model till {
  id                      Int                                    @id @default(autoincrement())
  tillCode                String                                 @unique
  tillName                String
  isActive                Boolean                                @default(true)
  companyId               Int
  branchId                Int
  posAccessCodeHash       String?
  posAccessCodeType       TillPosAssociationType?
  posAssociationType      TillPosAssociationType?
  posAssociatedIp         String?
  posAssociatedSessionId  String?
  posAssociationExpiresAt DateTime?
  branch                  branch                                 @relation(fields: [branchId], references: [id])
  company                 Company                                @relation(fields: [companyId], references: [id])
  cashSessions            CashSession[]
  paymentMethods          TillPaymentMethod[]
  electronicInvoicing     TillElectronicInvoicingConfiguration[]
  createdAt               DateTime                               @default(now())
  updatedAt               DateTime                               @updatedAt

  @@unique([branchId, tillCode])
  @@index([companyId, posAssociationType])
}

enum TillPosAssociationType {
  IP
  USER_SESSION
}

enum CashSessionStatus {
  OPEN
  EXPIRED
  CLOSED
}

model CashSession {
  id                    Int               @id @default(autoincrement())
  companyId             Int
  branchId              Int
  tillId                Int
  deviceKey             String
  openedByUserId        Int
  closedByUserId        Int?
  status                CashSessionStatus @default(OPEN)
  openedAt              DateTime          @default(now())
  expiresAt             DateTime
  closedAt              DateTime?
  openingAmount         Decimal           @db.Decimal(18, 4)
  expectedClosingAmount Decimal?          @db.Decimal(18, 4)
  declaredClosingAmount Decimal?          @db.Decimal(18, 4)
  differenceAmount      Decimal?          @db.Decimal(18, 4)
  openingNote           String?
  closingNote           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  company      Company @relation(fields: [companyId], references: [id])
  branch       branch  @relation(fields: [branchId], references: [id])
  till         till    @relation(fields: [tillId], references: [id])
  sales        Sale[]
  openedByUser User    @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedByUser User?   @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])

  @@index([companyId, status])
  @@index([branchId])
  @@index([tillId])
  @@index([openedByUserId])
  @@index([openedAt])
  @@index([deviceKey])
}

model Currency {
  id                Int               @id @default(autoincrement())
  code              String            @unique
  name              String
  symbol            String
  companiesDefault  Company[]         @relation("CompanyDefaultCurrency")
  companySettings   CompanyCurrency[]
  branches          branch[]
  exchangeRatesFrom ExchangeRate[]    @relation("ExchangeRateFrom")
  exchangeRatesTo   ExchangeRate[]    @relation("ExchangeRateTo")
  purchaseOrders    PurchaseOrder[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model CompanyCurrency {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  currencyId         Int
  isActive           Boolean  @default(true)
  symbol             String
  decimalPlaces      Int      @default(2)
  decimalSeparator   String   @default(".")
  thousandsSeparator String   @default(",")
  format             String   @default("symbol_before")
  rounding           String   @default("half_up")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([companyId, currencyId])
  @@index([companyId, isActive])
}

model ExchangeRate {
  id             Int      @id @default(autoincrement())
  companyId      Int
  fromCurrencyId Int
  toCurrencyId   Int
  date           DateTime @db.Date
  rate           Decimal  @db.Decimal(18, 6)
  company        Company  @relation(fields: [companyId], references: [id])
  fromCurrency   Currency @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([companyId, fromCurrencyId, toCurrencyId, date])
}

model PaymentMethod {
  id           Int                 @id @default(autoincrement())
  name         String
  code         String
  dianCode     String?
  image        String?
  isActive     Boolean             @default(true)
  companyId    Int
  company      Company             @relation(fields: [companyId], references: [id])
  sales        Sale[]
  salePayments SalePayment[]
  tills        TillPaymentMethod[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([companyId, code])
}

model TillPaymentMethod {
  tillId          Int
  paymentMethodId Int
  till            till          @relation(fields: [tillId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@id([tillId, paymentMethodId])
  @@index([paymentMethodId])
}

model Department {
  id             Int             @id @default(autoincrement())
  name           String
  code           String
  isActive       Boolean         @default(true)
  companyId      Int
  company        Company         @relation(fields: [companyId], references: [id])
  subdepartments Subdepartment[]
  products       Product[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([companyId, code])
}

model Subdepartment {
  id           Int        @id @default(autoincrement())
  name         String
  code         String
  isActive     Boolean    @default(true)
  departmentId Int
  companyId    Int        @default(1)
  department   Department @relation(fields: [departmentId], references: [id])
  company      Company    @relation(fields: [companyId], references: [id])
  categories   Category[]
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([companyId, code])
}

model Category {
  id              Int           @id @default(autoincrement())
  name            String
  code            String
  isActive        Boolean       @default(true)
  subdepartmentId Int
  companyId       Int           @default(1)
  subdepartment   Subdepartment @relation(fields: [subdepartmentId], references: [id])
  company         Company       @relation(fields: [companyId], references: [id])
  subcategories   Subcategory[]
  products        Product[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([companyId, code])
}

model Subcategory {
  id         Int       @id @default(autoincrement())
  name       String
  code       String
  isActive   Boolean   @default(true)
  categoryId Int
  companyId  Int       @default(1)
  category   Category  @relation(fields: [categoryId], references: [id])
  company    Company   @relation(fields: [companyId], references: [id])
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([companyId, code])
}

model Supplier {
  id               Int               @id @default(autoincrement())
  name             String
  taxId            String?
  address          String?
  phone            String?
  email            String?
  contactName      String?
  isActive         Boolean           @default(true)
  companyId        Int
  company          Company           @relation(fields: [companyId], references: [id])
  products         SupplierProduct[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Customer {
  id                   Int       @id @default(autoincrement())
  name                 String
  taxId                String?
  taxDocumentType      String?
  address              String?
  phone                String?
  email                String?
  contactName          String?
  isFinalConsumer      Boolean   @default(false)
  fiscalPersonType     String?
  taxCheckDigit        String?
  rutResponsibilities  String[]  @default([])
  taxRegime            String?
  fiscalAddress        String?
  fiscalCountryCode    String?   @db.Char(2)
  fiscalDepartmentCode String?
  fiscalDepartment     String?
  fiscalCityCode       String?
  fiscalCity           String?
  fiscalTaxCodes       String[]  @default([])
  isActive             Boolean   @default(true)
  companyId            Int
  company              Company   @relation(fields: [companyId], references: [id])
  defaultForCompanies  Company[] @relation("CompanyDefaultCustomer")
  sales                Sale[]
  orders               Order[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([companyId, taxDocumentType, taxId])
}

model Seller {
  id                  Int          @id @default(autoincrement())
  code                String
  name                String
  isActive            Boolean      @default(true)
  companyId           Int
  company             Company      @relation(fields: [companyId], references: [id])
  defaultForCompanies Company[]    @relation("CompanyDefaultSeller")
  sellerUsers         SellerUser[]
  sales               Sale[]
  orders              Order[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([companyId, code])
}

model SellerUser {
  id        Int      @id @default(autoincrement())
  sellerId  Int
  userId    Int
  companyId Int
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([sellerId, userId])
  @@index([companyId])
  @@index([userId])
}

model Product {
  id                   Int                     @id @default(autoincrement())
  sku                  String
  name                 String
  description          String?
  salePrice            Decimal                 @db.Decimal(18, 4)
  defaultPriceId       Int?                    @unique
  costPrice            Decimal?                @db.Decimal(18, 4)
  taxId                Int?
  tax                  Tax?                    @relation(fields: [taxId], references: [id])
  isExempt             Boolean                 @default(false)
  isActive             Boolean                 @default(true)
  productType          ProductType             @default(PRODUCT)
  companyId            Int
  departmentId         Int
  subdepartmentId      Int?
  categoryId           Int?
  subcategoryId        Int?
  unit                 String?
  dianCode             String?
  barcode              String?
  reference            String?
  image                String? // ruta relativa y nombre del archivo (ej. products/abc123.jpg)
  company              Company                 @relation(fields: [companyId], references: [id])
  department           Department              @relation(fields: [departmentId], references: [id])
  subdepartment        Subdepartment?          @relation(fields: [subdepartmentId], references: [id])
  category             Category?               @relation(fields: [categoryId], references: [id])
  subcategory          Subcategory?            @relation(fields: [subcategoryId], references: [id])
  prices               ProductPrice[]          @relation("ProductPrices")
  defaultPrice         ProductPrice?           @relation("ProductDefaultPrice", fields: [defaultPriceId], references: [id], onDelete: SetNull)
  supplierProducts     SupplierProduct[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  inventoryBalances    InventoryBalance[]
  inventoryMovements   InventoryMovement[]
  saleItems            SaleItem[]
  orderItems           OrderItem[]
  transferItems        InventoryTransferItem[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([companyId, sku])
  @@index([companyId, barcode])
  @@index([companyId, reference])
}

enum ProductType {
  PRODUCT
  SERVICE
}

model ProductPrice {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  amount    Decimal  @db.Decimal(18, 4)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation("ProductPrices", fields: [productId], references: [id], onDelete: Cascade)
  defaultFor Product?    @relation("ProductDefaultPrice")
  saleItems  SaleItem[]
  orderItems OrderItem[]

  @@index([productId, isActive, sortOrder])
}

model SupplierProduct {
  id         Int      @id @default(autoincrement())
  supplierId Int
  productId  Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  POSTED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE_RECEIPT
  PURCHASE_INVOICE
  MANUAL_ENTRY
  INVENTORY_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  ORDER_RESERVE
  ORDER_CANCEL
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum InventoryTransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id               Int                 @id @default(autoincrement())
  companyId        Int
  supplierId       Int
  warehouseId      Int
  currencyId       Int
  exchangeRate     Decimal             @default(1) @db.Decimal(18, 6)
  status           PurchaseOrderStatus @default(PENDING)
  notes            String?
  receivedAt       DateTime?
  receivedByUserId Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  company          Company             @relation(fields: [companyId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id])
  currency         Currency            @relation(fields: [currencyId], references: [id])
  items            PurchaseOrderItem[]
  purchaseInvoices PurchaseInvoice[]

  @@index([companyId, status])
  @@index([supplierId])
  @@index([warehouseId])
}

model PurchaseOrderItem {
  id              Int      @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  quantity        Decimal  @db.Decimal(18, 4)
  unitCost        Decimal  @db.Decimal(18, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id])
  movements     InventoryMovement[]

  @@unique([purchaseOrderId, productId])
}

model PurchaseInvoice {
  id                    Int                   @id @default(autoincrement())
  companyId             Int
  supplierId            Int
  warehouseId           Int
  purchaseOrderId       Int?
  seriesId              Int
  consecutive           Int
  documentNumber        String
  supplierInvoiceNumber String
  issueDate             DateTime
  status                PurchaseInvoiceStatus @default(POSTED)
  subtotal              Decimal               @db.Decimal(18, 4)
  taxAmount             Decimal               @db.Decimal(18, 4)
  total                 Decimal               @db.Decimal(18, 4)
  createdByUserId       Int
  postedAt              DateTime              @default(now())
  cancelledAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  company       Company               @relation(fields: [companyId], references: [id])
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  series        Series                @relation(fields: [seriesId], references: [id])
  createdByUser User                  @relation(fields: [createdByUserId], references: [id])
  items         PurchaseInvoiceItem[]
  movements     InventoryMovement[]

  @@unique([companyId, documentNumber])
  @@unique([companyId, supplierId, supplierInvoiceNumber])
  @@unique([seriesId, consecutive])
  @@index([companyId, issueDate])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([purchaseOrderId])
}

model PurchaseInvoiceItem {
  id                Int      @id @default(autoincrement())
  purchaseInvoiceId Int
  productId         Int
  quantity          Decimal  @db.Decimal(18, 4)
  unitCost          Decimal  @db.Decimal(18, 4)
  taxRate           Decimal  @db.Decimal(5, 4)
  taxAmount         Decimal  @db.Decimal(18, 4)
  lineTotal         Decimal  @db.Decimal(18, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseInvoice   PurchaseInvoice    @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id])
  inventoryMovement InventoryMovement?

  @@unique([purchaseInvoiceId, productId])
  @@index([productId])
}

model InventoryBalance {
  id          Int      @id @default(autoincrement())
  companyId   Int
  warehouseId Int
  productId   Int
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([companyId, productId])
}

model InventoryMovement {
  id                    Int                   @id @default(autoincrement())
  companyId             Int
  warehouseId           Int
  productId             Int
  type                  InventoryMovementType
  quantity              Decimal               @db.Decimal(18, 4)
  unitCost              Decimal               @db.Decimal(18, 4)
  balanceAfter          Decimal               @db.Decimal(18, 4)
  purchaseOrderId       Int?
  purchaseOrderItemId   Int?
  purchaseInvoiceId     Int?
  purchaseInvoiceItemId Int?
  saleItemId            Int?
  orderItemId           Int?
  createdByUserId       Int
  createdAt             DateTime              @default(now())

  company             Company              @relation(fields: [companyId], references: [id])
  warehouse           Warehouse            @relation(fields: [warehouseId], references: [id])
  product             Product              @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id])
  purchaseInvoice     PurchaseInvoice?     @relation(fields: [purchaseInvoiceId], references: [id])
  purchaseInvoiceItem PurchaseInvoiceItem? @relation(fields: [purchaseInvoiceItemId], references: [id])
  saleItem            SaleItem?            @relation(fields: [saleItemId], references: [id])
  orderItem           OrderItem?           @relation(fields: [orderItemId], references: [id])

  @@unique([purchaseOrderItemId])
  @@unique([purchaseInvoiceItemId])
  @@index([saleItemId])
  @@index([orderItemId])
  @@index([companyId, warehouseId, productId, createdAt])
  @@index([purchaseOrderId])
}

model Warehouse {
  id                   Int                 @id @default(autoincrement())
  name                 String
  code                 String              @unique
  address              String?
  isActive             Boolean             @default(true)
  companyId            Int
  company              Company             @relation(fields: [companyId], references: [id])
  branches             WarehouseBranch[]
  inventoryBalances    InventoryBalance[]
  inventoryMovements   InventoryMovement[]
  purchaseOrders       PurchaseOrder[]
  purchaseInvoices     PurchaseInvoice[]
  sourceTransfers      InventoryTransfer[] @relation("TransferSourceWarehouse")
  destinationTransfers InventoryTransfer[] @relation("TransferDestinationWarehouse")
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([companyId, code])
}

model InventoryTransfer {
  id                     Int                     @id @default(autoincrement())
  companyId              Int
  sourceWarehouseId      Int
  destinationWarehouseId Int
  status                 InventoryTransferStatus @default(PENDING)
  seriesId               Int?
  consecutive            Int?
  documentNumber         String?
  createdByUserId        Int
  controlStock           Boolean                 @default(true)
  notes                  String?
  dispatchedAt           DateTime?
  dispatchedByUserId     Int?
  receivedAt             DateTime?
  receivedByUserId       Int?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  company              Company                 @relation(fields: [companyId], references: [id])
  sourceWarehouse      Warehouse               @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse               @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  series               Series?                 @relation(fields: [seriesId], references: [id])
  createdByUser        User                    @relation("TransferCreatedBy", fields: [createdByUserId], references: [id])
  items                InventoryTransferItem[]

  @@index([companyId, status])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@unique([seriesId, consecutive])
}

model InventoryTransferItem {
  id         Int      @id @default(autoincrement())
  transferId Int
  productId  Int
  quantity   Decimal  @db.Decimal(18, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])

  @@unique([transferId, productId])
}

model WarehouseBranch {
  id          Int       @id @default(autoincrement())
  warehouseId Int
  branchId    Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  branch      branch    @relation(fields: [branchId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([warehouseId, branchId])
}

model Sale {
  id               Int      @id @default(autoincrement())
  companyId        Int
  branchId         Int
  cashSessionId    Int
  customerId       Int
  sellerId         Int
  paymentMethodId  Int?
  paymentReference String?
  createdByUserId  Int
  subtotal         Decimal  @db.Decimal(18, 4)
  taxAmount        Decimal  @db.Decimal(18, 4)
  total            Decimal  @db.Decimal(18, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company           Company            @relation(fields: [companyId], references: [id])
  branch            branch             @relation(fields: [branchId], references: [id])
  cashSession       CashSession        @relation(fields: [cashSessionId], references: [id])
  customer          Customer           @relation(fields: [customerId], references: [id])
  seller            Seller             @relation(fields: [sellerId], references: [id])
  paymentMethod     PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  createdByUser     User               @relation(fields: [createdByUserId], references: [id])
  items             SaleItem[]
  payments          SalePayment[]
  electronicInvoice ElectronicInvoice?
  order             Order?

  @@index([companyId, createdAt])
  @@index([cashSessionId])
  @@index([customerId])
  @@index([sellerId])
}

enum ElectronicInvoicingEnvironment {
  DEMO
  PRODUCTION
}

enum ElectronicInvoicingNumberingMode {
  WITH_PREFIX
  WITHOUT_PREFIX
}

enum ElectronicInvoiceStatus {
  PENDING
  PROCESSING
  ACCEPTED
  REJECTED
  FAILED
}

enum ElectronicInvoiceAttemptType {
  SUBMISSION
  STATUS_CHECK
}

enum ElectronicInvoiceDocumentType {
  INVOICE
}

enum ElectronicInvoiceArtifactType {
  PDF
  XML
}

model ElectronicInvoicingConfiguration {
  id                    Int                            @id @default(autoincrement())
  companyId             Int
  countryCode           String                         @db.Char(2)
  environment           ElectronicInvoicingEnvironment
  providerBaseUrl       String?
  credentialsCiphertext String
  credentialsNonce      String
  credentialsAuthTag    String
  encryptionKeyVersion  Int                            @default(1)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  company  Company                                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices ElectronicInvoice[]
  tills    TillElectronicInvoicingConfiguration[]

  @@unique([companyId, countryCode])
}

model TillElectronicInvoicingConfiguration {
  id                  Int                              @id @default(autoincrement())
  tillId              Int
  companyId           Int
  countryCode         String                           @db.Char(2)
  numberingMode       ElectronicInvoicingNumberingMode @default(WITH_PREFIX)
  numberingRange      String
  nextConsecutive     Int
  providerNumberingId String?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  till          till                             @relation(fields: [tillId], references: [id], onDelete: Cascade)
  company       Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  configuration ElectronicInvoicingConfiguration @relation(fields: [companyId, countryCode], references: [companyId, countryCode], onDelete: Cascade)
  invoices      ElectronicInvoice[]

  @@unique([tillId, countryCode])
  @@index([companyId, countryCode])
}

model ElectronicInvoice {
  id                  Int                           @id @default(autoincrement())
  saleId              Int                           @unique
  configurationId     Int
  tillConfigurationId Int
  documentType        ElectronicInvoiceDocumentType @default(INVOICE)
  status              ElectronicInvoiceStatus       @default(PENDING)
  consecutive         String
  requestPayload      Json
  providerResponse    Json?
  cufe                String?
  qr                  String?
  submittedAt         DateTime?
  acceptedAt          DateTime?
  retryCount          Int                           @default(0)
  nextRetryAt         DateTime?
  lastError           String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  sale              Sale                                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  configuration     ElectronicInvoicingConfiguration     @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  tillConfiguration TillElectronicInvoicingConfiguration @relation(fields: [tillConfigurationId], references: [id], onDelete: Restrict)
  attempts          ElectronicInvoiceAttempt[]
  artifacts         ElectronicInvoiceArtifact[]

  @@unique([tillConfigurationId, consecutive])
  @@index([status, nextRetryAt])
}

model ElectronicInvoiceAttempt {
  id                  Int                          @id @default(autoincrement())
  electronicInvoiceId Int
  type                ElectronicInvoiceAttemptType
  requestPayload      Json?
  providerResponse    Json?
  error               String?
  createdAt           DateTime                     @default(now())

  electronicInvoice ElectronicInvoice @relation(fields: [electronicInvoiceId], references: [id], onDelete: Cascade)

  @@index([electronicInvoiceId, createdAt])
}

model ElectronicInvoiceArtifact {
  id                  Int                           @id @default(autoincrement())
  electronicInvoiceId Int
  type                ElectronicInvoiceArtifactType
  storageKey          String                        @unique
  contentType         String
  size                Int
  checksum            String
  createdAt           DateTime                      @default(now())

  electronicInvoice ElectronicInvoice @relation(fields: [electronicInvoiceId], references: [id], onDelete: Cascade)

  @@unique([electronicInvoiceId, type])
}

model SalePayment {
  id              Int      @id @default(autoincrement())
  saleId          Int
  paymentMethodId Int
  amount          Decimal  @db.Decimal(18, 4)
  createdAt       DateTime @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([saleId])
}

model SaleItem {
  id             Int      @id @default(autoincrement())
  saleId         Int
  productId      Int
  productPriceId Int?
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @db.Decimal(18, 4)
  taxRate        Decimal  @db.Decimal(5, 4)
  taxAmount      Decimal  @db.Decimal(18, 4)
  lineTotal      Decimal  @db.Decimal(18, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sale               Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  productPrice       ProductPrice?       @relation(fields: [productPriceId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]

  @@unique([saleId, productId])
  @@index([productId])
}

model Order {
  id              Int         @id @default(autoincrement())
  companyId       Int
  branchId        Int?
  customerId      Int
  sellerId        Int?
  createdByUserId Int
  status          OrderStatus @default(PENDING)
  notes           String?
  saleId          Int?        @unique
  orderNumber     String?
  seriesId        Int?
  subtotal        Decimal     @db.Decimal(18, 4)
  taxAmount       Decimal     @db.Decimal(18, 4)
  total           Decimal     @db.Decimal(18, 4)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company       Company     @relation(fields: [companyId], references: [id])
  branch        branch?     @relation(fields: [branchId], references: [id])
  customer      Customer    @relation(fields: [customerId], references: [id])
  seller        Seller?     @relation(fields: [sellerId], references: [id])
  createdByUser User        @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  sale          Sale?       @relation(fields: [saleId], references: [id])
  series        Series?     @relation(fields: [seriesId], references: [id])
  items         OrderItem[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([customerId])
  @@index([sellerId])
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int
  productId      Int
  productPriceId Int?
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @db.Decimal(18, 4)
  taxRate        Decimal  @db.Decimal(5, 4)
  taxAmount      Decimal  @db.Decimal(18, 4)
  lineTotal      Decimal  @db.Decimal(18, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  productPrice       ProductPrice?       @relation(fields: [productPriceId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]

  @@unique([orderId, productId])
  @@index([productId])
}

model CompanyHierarchyConfig {
  id         Int     @id @default(autoincrement())
  companyId  Int     @unique
  level1Name String  @default("Departamento")
  level2Name String  @default("Subdepartamento")
  level3Name String  @default("Categoría")
  level4Name String  @default("Subcategoría")
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum SeriesModule {
  ORDERS
  PURCHASE_INVOICES
  INVENTORY_TRANSFERS
}

model Series {
  id          Int          @id @default(autoincrement())
  description String
  format      String
  consecutive Int          @default(1)
  module      SeriesModule
  isActive    Boolean      @default(true)
  companyId   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders             Order[]
  purchaseInvoices   PurchaseInvoice[]
  inventoryTransfers InventoryTransfer[]

  @@unique([companyId, module])
  @@index([companyId])
}
